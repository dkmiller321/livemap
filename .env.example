# Copy to .env.
# Livemap itself never reads this file: it takes command-line flags only.
# It is read by playwright.config.ts, the npm example scripts and the example apps.

# --- Livemap under test ---
# Page and API port (livemap --port).
LIVEMAP_PORT=4400
# OpenTelemetry receiver port (livemap --otlp-port). Never use 4317: KitForge owns it.
LIVEMAP_OTLP_PORT=4318
# Command the specs use to spawn Livemap. Blank = node bin/livemap.mjs.
# Final acceptance sets this to the packed install's node_modules/.bin/livemap.
LIVEMAP_BIN=
# Set both to test an already-running Livemap instead of letting Playwright start one.
BASE_URL=
OTLP_URL=

# --- Example apps (stage 4 onwards) ---
MOCK_LLM_PORT=4599
NODE_EXAMPLE_PORT=4501
PYTHON_EXAMPLE_PORT=4502
# Python 3.10 or newer, used by `npm run examples:setup` to create examples/python-app/.venv.
PYTHON_BIN=python3

# --- LLM ---
# 1 = the examples call the scripted mock LLM server. Leave on for every normal test run.
MOCK_LLM=1
# The three below are used only when MOCK_LLM=0, which only the smoke suite needs.
# Any OpenAI-compatible endpoint works. Blank base URL = https://api.openai.com/v1.
LLM_BASE_URL=
# Set a spend limit on this key with your provider.
LLM_API_KEY=
# A small, cheap chat model from that provider.
LLM_MODEL=

# --- Testing ---
# 1 = also run the real-model @smoke suite. Needs MOCK_LLM=0, LLM_API_KEY and LLM_MODEL.
RUN_SMOKE=0
